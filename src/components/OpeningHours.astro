---
// Opening hours from the site's hours.toml: the regular week, then every exception in the file.
// Exceptions stay visible until they are removed from the file.
import { hours, copyFor, langOf } from '../runtime.js';
import { DAYS, weekdayNames, formatDate } from '../hours.js';

interface Props {
  /** Group consecutive days with the same hours: "woensdag t.e.m. zaterdag". */
  compact?: boolean;
  /** Leave out days (or groups of days) when closed. */
  hideClosed?: boolean;
}
const { compact = false, hideClosed = false } = Astro.props;
if (!hours) throw new Error('site-kit: <OpeningHours> needs hours = "src/data/hours.toml" in site.config');
const lang = langOf(Astro.currentLocale);
const t = copyFor(lang).kit.hours;
const names = weekdayNames(lang);
const hasNotes = hours.exceptions.some((e) => e.note[lang]);

// One row per day, or per run of consecutive days with identical hours.
const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
const rows = [];
DAYS.forEach((day, index) => {
  const intervals = hours.week[day];
  const last = rows.at(-1);
  if (compact && last && same(last.intervals, intervals)) last.to = index;
  else rows.push({ from: index, to: index, intervals });
});
const visibleRows = rows
  .filter((row) => !(hideClosed && row.intervals.length === 0))
  .map((row) => ({ ...row, label: row.from === row.to ? names[row.from] : `${names[row.from]} ${t.through} ${names[row.to]}` }));
---
<table>
  <caption>{t.caption}</caption>
  <thead>
    <tr><th scope="col">{t.day}</th><th scope="col">{t.times}</th></tr>
  </thead>
  <tbody>
    {visibleRows.map((row) => (
      <tr>
        <th scope="row">{row.label}</th>
        <td>
          {row.intervals.length === 0
            ? t.closed
            : row.intervals.map(([open, close], i) => (
                <Fragment>{i > 0 && ', '}<time datetime={open}>{open}</time>–<time datetime={close}>{close}</time></Fragment>
              ))}
        </td>
      </tr>
    ))}
  </tbody>
</table>
{hours.exceptions.length > 0 && (
  <table>
    <caption>{t.exceptionsCaption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.date}</th>
        <th scope="col">{t.times}</th>
        {hasNotes && <th scope="col">{t.note}</th>}
      </tr>
    </thead>
    <tbody>
      {hours.exceptions.map((e) => (
        <tr>
          <th scope="row">
            <time datetime={e.date}>{formatDate(e.date, lang)}</time>
            {e.to && <Fragment>{` ${t.until} `}<time datetime={e.to}>{formatDate(e.to, lang)}</time></Fragment>}
          </th>
          <td>
            {e.closed
              ? t.closed
              : e.hours.map(([open, close], i) => (
                  <Fragment>{i > 0 && ', '}<time datetime={open}>{open}</time>–<time datetime={close}>{close}</time></Fragment>
                ))}
          </td>
          {hasNotes && <td>{e.note[lang] ?? ''}</td>}
        </tr>
      ))}
    </tbody>
  </table>
)}
